rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated()
        && (request.auth.token.admin == true
            || request.auth.token.superAdmin == true);
    }

    // Helper function to validate image file
    function isValidImage() {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp|bmp)')
        && request.resource.size < 5 * 1024 * 1024; // Max 5MB
    }

    // Profile images
    match /profiles/{userId}/{fileName} {
      // Users can read any profile image
      allow read: if isAuthenticated();

      // Users can only upload their own profile images
      allow write: if isOwner(userId)
        && isValidImage();

      // Users can delete their own profile images
      allow delete: if isOwner(userId);
    }

    // Conversation media (images + voice for P2P chats)
    // Paths: conversations/{id}/images/{file}, conversations/{id}/voice/{file}
    match /conversations/{conversationId}/{mediaType}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024; // Max 10MB
      allow delete: if false;
    }

    // Community media (images + voice for group chats)
    // Paths: communities/{id}/images/{file}, communities/{id}/voice/{file}
    match /communities/{communityId}/{mediaType}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024; // Max 10MB
      allow delete: if false;
    }

    // Receipt images for purchases/cashouts
    match /receipts/{userId}/{receiptId}/{fileName} {
      // Only owner can read their receipts
      allow read: if isOwner(userId);

      // Only owner can upload receipts
      allow write: if isOwner(userId)
        && isValidImage();

      // No deletion of receipt images
      allow delete: if false;
    }

    // ID verification documents (sensitive)
    match /verification/{userId}/{docType}/{fileName} {
      // Only owner can read their verification docs
      allow read: if isOwner(userId);

      // Only owner can upload verification docs
      allow write: if isOwner(userId)
        && request.resource.contentType.matches('(image/(png|jpeg|jpg)|application/pdf)')
        && request.resource.size < 10 * 1024 * 1024; // Max 10MB

      // No deletion of verification documents
      allow delete: if false;
    }

    // Client logos (admin managed)
    match /client_logos/{fileName} {
      // Authenticated users can read client logos (for display in app)
      allow read: if isAuthenticated();

      // Only admins can upload/update client logos
      allow write: if isAdmin()
        && isValidImage();

      // Only admins can delete client logos
      allow delete: if isAdmin();
    }

    // Campaign/thread images (admin managed)
    match /thread_images/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Opportunity images (admin managed)
    match /opportunity_images/{threadId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Earn videos (admin managed)
    match /earn_videos/{threadId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin()
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 50 * 1024 * 1024; // Max 50MB
      allow delete: if isAdmin();
    }

    // User engagement uploads (video/image from upload earning type)
    match /engagement_uploads/{engagementId}/{uploadType}/{fileName} {
      // Authenticated users can read uploads (admins review them)
      allow read: if isAuthenticated();

      // Authenticated users can upload files (max 50MB for video, 10MB for image)
      allow write: if isAuthenticated()
        && request.resource.size < 50 * 1024 * 1024;

      // No deletion of engagement uploads
      allow delete: if false;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
