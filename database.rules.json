{
  "rules": {
    "callSignaling": {
      "$callId": {
        ".read": "auth != null && (data.child('participants').child(auth.uid).exists() || !data.exists())",
        ".write": "auth != null && (data.child('participants').child(auth.uid).exists() || !data.exists())"
      }
    },
    ".read": false,
    ".write": false
  }
}
