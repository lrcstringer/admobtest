rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAppChecked() {
      return request.app != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(field) {
      return field is timestamp;
    }

    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    function isValidInt(field, min, max) {
      return field is int && field >= min && field <= max;
    }

    function isAdmin() {
      return isAuthenticated()
        && (request.auth.token.admin == true
            || request.auth.token.superAdmin == true);
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);

      // Users can create their own profile during signup
      // TODO: Re-add isAppChecked() once App Check is enabled (requires Play Store)
      allow create: if isOwner(userId)
        && isValidString(request.resource.data.displayName, 2, 50)
        && isValidString(request.resource.data.phoneNumber, 10, 15);

      // Users can update their own profile with restrictions
      // Note: oddienceUserId is the document ID (not stored as a field),
      // so isOwner(userId) already prevents cross-user updates.
      // TODO: Re-add isAppChecked() once App Check is enabled (requires Play Store)
      allow update: if isOwner(userId)
        && isValidString(request.resource.data.displayName, 2, 50)
        // Prevent changing phone number
        && request.resource.data.phoneNumber == resource.data.phoneNumber;

      // Users cannot delete their profile (handled by Cloud Function)
      allow delete: if false;
    }

    // Wallets collection
    match /wallets/{walletId} {
      // Users can read wallets they own
      allow read: if isAuthenticated()
        && resource.data.oddienceUserId == request.auth.uid;

      // Wallets are created by Cloud Functions only
      allow create: if false;

      // Wallets are updated by Cloud Functions only
      // This prevents client-side balance manipulation
      allow update: if false;

      allow delete: if false;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if isAuthenticated()
        && resource.data.oddienceUserId == request.auth.uid;

      // Transactions are created by Cloud Functions only
      allow create: if false;

      // Transactions cannot be modified or deleted
      allow update, delete: if false;
    }

    // Chat threads collection
    match /chatThreads/{threadId} {
      // Users can read threads they participate in
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participantIds;

      // Users can create threads
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds;

      // Threads are updated by Cloud Functions on new messages
      allow update: if false;

      allow delete: if false;
    }

    // Chat messages collection
    match /chatMessages/{messageId} {
      // Users can read messages in their threads
      allow read: if isAuthenticated();

      // Users can send messages
      // TODO: Re-add isAppChecked() once App Check is enabled (requires Play Store)
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && isValidString(request.resource.data.content, 0, 1000);

      // Messages cannot be modified or deleted
      allow update, delete: if false;
    }

    // Pot pools collection
    match /potPools/{potId} {
      // Anyone authenticated can read active pots
      allow read: if isAuthenticated();

      // Pots are managed by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Pot entries collection
    match /potEntries/{entryId} {
      // Users can read their own entries
      allow read: if isAuthenticated()
        && resource.data.oddienceUserId == request.auth.uid;

      // Entries are created by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Pot winners collection
    match /potWinners/{winnerId} {
      // Winners are public (for leaderboard)
      allow read: if isAuthenticated();

      // Winners are determined by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Leaderboard collection
    match /leaderboard/{userId} {
      // Leaderboard is public
      allow read: if isAuthenticated();

      // Leaderboard is updated by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Referral codes collection
    match /referralCodes/{codeId} {
      // Anyone can read referral codes (to validate)
      allow read: if isAuthenticated();

      // Users can create their own referral code
      // TODO: Re-add isAppChecked() once App Check is enabled (requires Play Store)
      allow create: if isAuthenticated()
        && request.resource.data.oddienceUserId == request.auth.uid;

      // Codes cannot be modified or deleted
      allow update, delete: if false;
    }

    // Referrals collection
    match /referrals/{referralId} {
      // Users can read referrals where they are referrer or referee
      allow read: if isAuthenticated()
        && (resource.data.referrerUserId == request.auth.uid
            || resource.data.refereeUserId == request.auth.uid);

      // Referrals are processed by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Referral stats collection
    match /referralStats/{userId} {
      // Users can read their own stats
      allow read: if isOwner(userId);

      // Stats are updated by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Cashouts collection
    match /cashouts/{cashoutId} {
      // Users can read their own cashouts; admins can read all (for approval screen)
      allow read: if isAuthenticated()
        && (resource.data.oddienceUserId == request.auth.uid
            || isAdmin());

      // Cashouts are processed by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Purchases collection
    match /purchases/{purchaseId} {
      // Users can read their own purchases
      allow read: if isAuthenticated()
        && resource.data.oddienceUserId == request.auth.uid;

      // Purchases are processed by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Service providers collection
    match /serviceProviders/{providerId} {
      // Anyone authenticated can read providers
      allow read: if isAuthenticated();

      // Providers are managed by admins only (via console)
      allow create, update, delete: if false;
    }

    // Service products collection
    match /serviceProducts/{productId} {
      // Anyone authenticated can read products
      allow read: if isAuthenticated();

      // Products are managed by admins only
      allow create, update, delete: if false;
    }

    // Feature flags collection
    match /featureFlags/{flagId} {
      // Authenticated users can read flags (needed for client-side feature gating)
      allow read: if isAuthenticated();

      // Flags are managed by admin Cloud Functions only
      allow create, update, delete: if false;
    }

    // Buy categories collection
    match /buyCategories/{categoryId} {
      // Authenticated users can read categories
      allow read: if isAuthenticated();

      // Categories are managed by admin Cloud Functions only
      allow create, update, delete: if false;
    }

    // Featured items collection
    match /featuredItems/{itemId} {
      // Authenticated users can read featured items
      allow read: if isAuthenticated();

      // Featured items are managed by admin Cloud Functions only
      allow create, update, delete: if false;
    }

    // Brand storefronts collection
    match /brandStorefronts/{storefrontId} {
      // Authenticated users can read brand storefronts
      allow read: if isAuthenticated();

      // Brand storefronts are managed by admin Cloud Functions only
      allow create, update, delete: if false;

      // Brand products subcollection (admin-configured per brand)
      match /products/{productId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if false;
      }
    }

    // Brand products collection
    match /brandProducts/{productId} {
      // Authenticated users can read brand products
      allow read: if isAuthenticated();

      // Products are managed by admin Cloud Functions only
      allow create, update, delete: if false;
    }

    // Brand reviews collection
    match /brandReviews/{reviewId} {
      // Authenticated users can read non-removed reviews
      allow read: if isAuthenticated();

      // Reviews are submitted/edited via Cloud Functions only
      allow create, update, delete: if false;
    }

    // Group buy deal suggestions
    match /groupBuyRequests/{requestId} {
      // Users can read their own suggestions
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Suggestions are submitted via Cloud Functions only
      allow create, update, delete: if false;
    }

    // Marketplace providers collection
    match /providers/{providerId} {
      // Authenticated users can read providers (browse marketplace)
      allow read: if isAuthenticated();

      // Providers are managed by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Marketplace listings collection
    match /marketplaceListings/{listingId} {
      // Authenticated users can read listings
      allow read: if isAuthenticated();

      // Listings are managed by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Marketplace orders collection
    match /buyOrders/{orderId} {
      // Users can read their own orders (buyer or seller)
      allow read: if isAuthenticated()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);

      // Orders are managed by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Vouches collection
    match /vouches/{vouchId} {
      // Authenticated users can read vouches
      allow read: if isAuthenticated();

      // Vouches are managed by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Marketplace reports collection
    match /marketplaceReports/{reportId} {
      // Reports are admin-only (users submit via Cloud Functions)
      allow read, write: if false;
    }

    // Group buys (Hlangana)
    match /groupBuys/{groupBuyId} {
      // Authenticated users can read group buys (browse deals)
      allow read: if isAuthenticated();

      // Group buys are managed by Cloud Functions only
      allow create, update, delete: if false;

      // Contributions subcollection
      match /contributions/{contributionId} {
        // Authenticated users can read contributions
        allow read: if isAuthenticated();

        // Contributions are managed by Cloud Functions only
        allow create, update, delete: if false;
      }
    }

    // Buy regulars subcollection (user's quick-buy shortcuts)
    match /users/{userId}/buyRegulars/{regularId} {
      // Users can read their own regulars
      allow read: if isOwner(userId);

      // Regulars are managed by Cloud Functions only (auto-created on purchase)
      allow create, update, delete: if false;
    }

    // Platform stats collection (admin only)
    match /platformStats/{statId} {
      // Stats are admin-only
      allow read, write: if false;
    }

    // Earnings collection
    match /earnings/{earningId} {
      // Users can read their own earnings
      allow read: if isAuthenticated()
        && resource.data.oddienceUserId == request.auth.uid;

      // Earnings are created by Cloud Functions only
      allow create, update, delete: if false;
    }

    // Blocked users collection (admin managed)
    match /blockedUsers/{userId} {
      allow read, write: if false;
    }

    // Fraud alerts collection (admin managed)
    match /fraudAlerts/{alertId} {
      allow read, write: if false;
    }

    // Verification codes collection (Cloud Functions only)
    // Used for OTP verification during phone authentication
    match /verification_codes/{phoneNumber} {
      allow read, write: if false;
    }

    // Trusted devices collection (server-only writes via Cloud Functions)
    // Users can read their own devices; all writes through Admin SDK
    // Exception: owner can update recovery key fields for E2EE payload recovery
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['recoveryKeyBlob', 'recoveryKeyIv', 'recoveryKeyDirect']);
      allow create, delete: if false;
    }

    // Auth challenges collection (server-only via Cloud Functions)
    // Push-based login challenge/response. Status is polled via
    // checkChallengeStatus cloud function (not direct Firestore reads)
    // because the requesting client is unauthenticated.
    match /authChallenges/{challengeId} {
      // Authenticated users can read their own challenges (for approval screen)
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Biometric challenges collection (server-only via Cloud Functions)
    // Used for biometric login nonce challenge/response
    match /biometricChallenges/{challengeId} {
      allow read, write: if false;
    }

    // Rate limits collection (server-only via Cloud Functions)
    // Used by security middleware for rate limiting
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Risk events collection (server-only writes via Cloud Functions)
    // Tracks SIM changes, geo changes, large transactions, etc.
    match /riskEvents/{eventId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // TRUST LEDGER COLLECTIONS
    // All ledger collections are server-only to maintain integrity
    // =========================================================================

    // Ledger accounts collection
    // Stores all account balances (user, system, pot, supplier, cashout)
    match /ledgerAccounts/{accountId} {
      // Users can read their own account
      // Account IDs follow format: "user:{userId}", "supplier:{id}", etc.
      allow read: if isAuthenticated()
        && (accountId == 'user:' + request.auth.uid
            || resource.data.ownerId == request.auth.uid
            || isAdmin());

      // All writes handled by Cloud Functions only
      // This ensures balance integrity through atomic transactions
      allow create, update, delete: if false;

      // Sub-accounts (wallets) subcollection
      match /subAccounts/{subAccountId} {
        allow read: if isAuthenticated()
          && (accountId == 'user:' + request.auth.uid
              || isAdmin());
        allow create, update, delete: if false;
      }
    }

    // Account types collection (brand wallet definitions)
    match /accountTypes/{typeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Ledger journals collection
    // Immutable double-entry bookkeeping records
    match /ledgerJournals/{journalId} {
      // Users can read journals where their account is a participant
      // participantAccountIds is a denormalized array written at journal creation
      // Legacy journals without this field are admin-only
      allow read: if isAuthenticated()
        && (('participantAccountIds' in resource.data
              && ('user:' + request.auth.uid) in resource.data.participantAccountIds)
            || isAdmin());

      // Journals are immutable and created by Cloud Functions only
      // Corrections are done via reversal journals, never mutation
      allow create, update, delete: if false;
    }

    // Ledger snapshots collection
    // Periodic balance snapshots for reconciliation
    match /ledgerSnapshots/{snapshotId} {
      // Snapshots are server-only for reconciliation
      allow read, write: if false;
    }

    // Ledger audit collection
    // Complete audit trail of all ledger operations
    match /ledgerAudit/{auditId} {
      // Audit logs are admin-only
      allow read, write: if false;
    }

    // =========================================================================
    // GROUP ACCOUNT COLLECTIONS
    // Groups allow multiple users to share pooled funds with role-based permissions
    // =========================================================================

    // Helper function to check if user is a member of a group
    function isGroupMember(groupId) {
      return request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Helper function to check if user is owner of a group
    function isGroupOwner(groupId) {
      return request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId;
    }

    // Groups collection
    match /groups/{groupId} {
      // Members can read their groups
      allow read: if isAuthenticated() && isGroupMember(groupId);

      // Any authenticated user can create a group
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // Only owner can update group settings
      // Most updates should go through Cloud Functions for validation
      allow update: if isAuthenticated() && isGroupOwner(groupId);

      // Only owner can delete (close) group
      allow delete: if isAuthenticated() && isGroupOwner(groupId);

      // Group members subcollection
      match /members/{memberId} {
        // Members can read all member records in their group
        allow read: if isAuthenticated() && isGroupMember(groupId);

        // Member management is handled by Cloud Functions only
        // This ensures proper permission checking and notifications
        allow create, update, delete: if false;
      }

      // Group transactions subcollection
      match /transactions/{transactionId} {
        // Members can read transactions in their group
        allow read: if isAuthenticated() && isGroupMember(groupId);

        // All transactions are processed by Cloud Functions only
        // This ensures ledger integrity and proper balance tracking
        allow create, update, delete: if false;
      }

      // Pending approvals subcollection
      match /pendingApprovals/{approvalId} {
        // Members can read pending approvals in their group
        allow read: if isAuthenticated() && isGroupMember(groupId);

        // Approvals are managed by Cloud Functions only
        allow create, update, delete: if false;
      }
    }

    // Pots collection (legacy, now backed by ledger)
    match /pots/{potId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Leaderboards collection with subcollections
    match /leaderboards/{leaderboardId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      match /scores/{scoreId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if false;
      }
    }

    // Earn opportunities collection
    match /earnOpportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Earn threads collection
    match /earnThreads/{threadId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // User engagement stats collection (streak tracking)
    // Document ID is the userId
    match /userEngagementStats/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Engagements collection
    match /engagements/{engagementId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Payment requests collection (legacy)
    match /paymentRequests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.requesterId == request.auth.uid
            || resource.data.payerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Clients collection (advertising clients)
    // Reads via Cloud Functions (getEligibleThreads denormalizes client data)
    // Admin CRUD via Cloud Functions with admin token
    match /clients/{clientId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;

      // Client sub-accounts for budget tracking
      match /subAccounts/{subAccountId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // =========================================================================
    // ADMOB SSV CALLBACKS
    // Server-Side Verification records from AdMob
    // =========================================================================

    // Polls collection
    match /polls/{pollId} {
      // Any authenticated user can read poll metadata (for voting)
      allow read: if isAuthenticated();

      // Only admin can create/update polls
      allow create, update: if isAdmin();
      allow delete: if false;

      // Poll responses subcollection (one doc per user)
      match /responses/{userId} {
        // Users can read their own response
        allow read: if isOwner(userId);

        // All writes through Cloud Functions only (ensures atomic counter updates)
        allow create, update, delete: if false;
      }
    }

    // AdMob SSV callbacks collection
    // Stores verification records from AdMob server-side callbacks
    // All writes are from Cloud Functions only (the SSV endpoint)
    match /admobSSVCallbacks/{transactionId} {
      // No client reads - verification is done via Cloud Function (verifyAdMobTransaction)
      allow read: if false;

      // All writes are from Cloud Functions only (admobSSVCallback endpoint)
      allow create, update, delete: if false;
    }

    // =========================================================================
    // REWARD INVENTORY COLLECTIONS
    // Non-fungible reward items (QR codes, vouchers, etc.)
    // =========================================================================

    // Reward campaigns collection
    match /rewardCampaigns/{campaignId} {
      // Authenticated users can read active campaigns
      allow read: if isAuthenticated();

      // All writes through Cloud Functions only
      allow create, update, delete: if false;
    }

    // Reward items collection
    match /rewardItems/{itemId} {
      // Users can read their own allocated items; admins can read all
      allow read: if isAuthenticated()
        && (resource.data.allocatedToUserId == request.auth.uid
            || isAdmin());

      // All writes through Cloud Functions only
      allow create, update, delete: if false;
    }

    // Failed reward allocations (admin-managed retry queue)
    match /failedRewardAllocations/{docId} {
      allow read: if isAdmin();
      // Admins can mark as resolved; creates/deletes via Cloud Functions only
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // Reward activity log (append-only audit trail)
    match /rewardActivityLog/{logId} {
      // Admin-only reads
      allow read: if isAdmin();

      // All writes through Cloud Functions only
      allow create, update, delete: if false;
    }

    // Platform settings collection (admin-managed feature flags)
    match /platformSettings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // CONVERSATIONS (P2P Direct Messages)
    // All writes via Cloud Functions — clients are read-only
    // =========================================================================

    function isConversationParticipant(convId) {
      return request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
    }

    match /conversations/{convId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isAuthenticated() && isConversationParticipant(convId);
        allow write: if false;
      }

      // Typing indicators — ephemeral, direct client writes allowed
      match /typing/{typingUserId} {
        allow read: if isAuthenticated() && isConversationParticipant(convId);
        allow write: if isAuthenticated()
          && request.auth.uid == typingUserId
          && isConversationParticipant(convId);
      }
    }

    // =========================================================================
    // COMMUNITIES (Regular + Stokvel)
    // All writes via Cloud Functions — clients are read-only
    // =========================================================================

    function isCommunityMember(commId) {
      return request.auth.uid in get(/databases/$(database)/documents/communities/$(commId)).data.memberIds;
    }

    match /communities/{commId} {
      allow read: if isAuthenticated() && isCommunityMember(commId);
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isAuthenticated() && isCommunityMember(commId);
        allow write: if false;
      }

      match /members/{memberId} {
        allow read: if isAuthenticated() && isCommunityMember(commId);
        allow write: if false;
      }

      match /transactions/{txId} {
        allow read: if isAuthenticated() && isCommunityMember(commId);
        allow write: if false;
      }

      match /pendingApprovals/{approvalId} {
        allow read: if isAuthenticated() && isCommunityMember(commId);
        allow write: if false;
      }

      match /keyDistribution/{distId} {
        allow read: if isAuthenticated() && resource.data.toUserId == request.auth.uid;
        allow write: if false;
      }
    }

    // =========================================================================
    // GIFTS (P2P and Community)
    // All writes via Cloud Functions — clients can read if sender or recipient
    // =========================================================================

    match /gifts/{giftId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow write: if false;
    }

    // =========================================================================
    // TOKEN SPRAYS (Community celebrations)
    // All writes via Cloud Functions — community members can read
    // =========================================================================

    match /tokenSprays/{sprayId} {
      allow read: if isAuthenticated() &&
        isCommunityMember(resource.data.communityId);
      allow write: if false;
    }

    // =========================================================================
    // TOKEN POOLS (Group Sasaza & Group Save)
    // All writes via Cloud Functions — participants and recipient can read
    // =========================================================================

    match /tokenPools/{poolId} {
      allow read: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        request.auth.uid in resource.data.inviteeIds ||
        resource.data.recipientId == request.auth.uid
      );
      allow write: if false;
    }

    // =========================================================================
    // REPORTS (Abuse reports)
    // Users can read their own reports, writes via Cloud Functions
    // =========================================================================

    match /reports/{reportId} {
      allow read: if isAuthenticated() &&
        resource.data.reporterId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // USER KEY BUNDLES (E2EE)
    // Users can read any public key bundle, but only write their own
    // =========================================================================

    match /users/{userId}/keys/{keyDoc} {
      // Public key bundle: any authenticated user can read (needed for E2EE key exchange)
      // Backup metadata: only the key owner can read
      allow read: if isAuthenticated() &&
        (keyDoc == 'bundle' || request.auth.uid == userId);
      allow write: if false;
    }

    // =========================================================================
    // PAYLOAD VAULT (E2EE recovery payloads)
    // Encrypted message payloads for recovery after reinstall.
    // Owner-only read/write — data is AES-GCM encrypted with recovery key.
    // =========================================================================

    match /users/{userId}/payloadVault/{msgId} {
      allow read, write: if isOwner(userId);
    }

    // =========================================================================
    // CALLS (Voice/Video 1:1 Calling)
    // Call creation and terminal writes via Cloud Functions
    // Signaling writes (SDP, ICE, heartbeat) via client SDK
    // =========================================================================

    function isCallParticipant() {
      return resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid;
    }

    match /calls/{callId} {
      // Only call participants can read
      allow read: if isAuthenticated() && isCallParticipant();

      // Created by Cloud Function (initiateCall) only
      allow create: if false;

      // Participants can update ONLY their own signaling fields.
      // Status transitions, identity fields, and timestamps are server-only.
      allow update: if isAuthenticated() && isCallParticipant()
        && (
          // Caller: can write offer SDP, their heartbeat, ICE restart count,
          // and video upgrade request fields
          (resource.data.callerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['offer', 'callerHeartbeat', 'iceRestartCount',
                           'videoUpgradeRequest', 'videoUpgradeRequesterId']))
          ||
          // Callee: can write answer SDP, their heartbeat,
          // and video upgrade response
          (resource.data.calleeId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answer', 'calleeHeartbeat',
                           'videoUpgradeRequest']))
        );

      // TTL handles cleanup — no client deletes
      allow delete: if false;

      // Caller ICE candidates subcollection
      match /callerCandidates/{candidateId} {
        // Both participants can read (callee needs caller's candidates).
        // Must use get() — resource.data is the candidate doc, not the call doc.
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
              || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        // Only caller can write their ICE candidates
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
        allow update, delete: if false;
      }

      // Callee ICE candidates subcollection
      match /calleeCandidates/{candidateId} {
        // Both participants can read (caller needs callee's candidates).
        // Must use get() — resource.data is the candidate doc, not the call doc.
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
              || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        // Only callee can write their ICE candidates
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // ADMIN RBAC COLLECTIONS
    // Admin user registry, maker-checker queue, and immutable audit trail
    // =========================================================================

    // Admin users registry (role assignments)
    match /adminUsers/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Maker-checker pending actions queue
    match /adminPendingActions/{actionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Immutable admin audit log
    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // COLLECTION GROUP: members
    // Allows collectionGroup('members') queries for pending invitations.
    // A user can read any member doc where they are the member (userId match).
    // This enables getPendingInvitations() across communities and groups.
    // =========================================================================

    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // COLLECTION GROUP: contributions
    // Allows collectionGroup('contributions') queries for getMyGroupBuys().
    // A user can read any contribution doc where they are the contributor.
    // =========================================================================

    match /{path=**}/contributions/{contributionId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }
  }
}
